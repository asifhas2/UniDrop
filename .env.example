# ========================================================
# UniDrop Server Environment Configuration Template
# ========================================================
# Note: Never commit real credentials or production keys.
# Copy this file to .env before starting the server.

# Server Port & Host
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and Socket.IO origin checks)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/unidrop
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/unidrop?retryWrites=true&w=majority
# If left empty in development, UniDrop will automatically launch an in-memory database!
MONGODB_URI=

# Cryptographic Secrets (Use minimum 32-character random strings in production)
SESSION_SECRET=unidrop-dev-session-secret-change-in-production-min32chars
ADMIN_JWT_SECRET=unidrop-dev-admin-jwt-secret-change-in-production-min32chars
ADMIN_JWT_EXPIRES_IN=8h

# Default Administrative Credentials (seeded on first initialization if database is empty)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=UniDropAdmin2026!
DEFAULT_ADMIN_EMAIL=admin@unidrop.local

# Transfer & Security Policies
FILE_MAX_SIZE_BYTES=104857600
SESSION_TTL_MINUTES=10
TEMP_FILE_TTL_MINUTES=15
PAIRING_PIN_TTL_MINUTES=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# STUN / TURN Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
